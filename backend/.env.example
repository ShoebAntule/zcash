NODE_ENV=development
DATABASE_URL=
# Local inventory testing only; never authorizes payment or issuance.
ENABLE_RESERVATION_PREVIEW=true
# Explicit opt-in for the old standalone payment diagnostic.
ENABLE_PAYMENT_POC=false
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------
# ZEC payment POC
# -----------------------------
# Testnet only for Part 4. The backend refuses "mainnet" while POC_ONLY=true.
POC_ONLY=true
ZCASH_NETWORK=testnet

# Public address of the dedicated project-controlled TESTNET recipient wallet.
# Create this wallet manually in the official Noir testnet extension.
# NEVER paste the seed phrase/private key into this project.
MINT_PAYMENT_ADDRESS=

# Tiny test amount. Decimal ZEC string; not JavaScript float arithmetic.
POC_PAYMENT_AMOUNT_ZEC=0.001

# POC confirmation policy.
# A submitted tx is treated as CONFIRMED only after this many confirmations.
POC_REQUIRED_CONFIRMATIONS=1

# Optional during UI/wallet setup. Required only for independent tx verification.
# Trusted Zcash JSON-RPC endpoint used to prove that the submitted tx exists
# and to read confirmation count. For an arbitrary txid this endpoint generally
# needs transaction indexing / equivalent lookup support.
ZCASH_RPC_URL=
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
ZCASH_RPC_TIMEOUT_MS=8000

# ZSA values remain intentionally unused in Part 4.
ZSA_NETWORK=zsa-test
ZSA_RPC_URL=
ZSA_CLI_PATH=
ZSA_PROVIDER=disabled

# Future mint configuration (kept paused).
MINT_STATUS=PAUSED
MINT_PRICE_ZEC=0.001
MINT_MAX_SUPPLY=10
MINT_MAX_PER_TX=2
